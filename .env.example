# Telegram is required for live notifications. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Cloudflare Workers AI. Keep unset for rule-based-only mode.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_ONLY_ACK=I_UNDERSTAND_FREE_ONLY

# Bounded publishing / Telegram processing. Keep these limits finite.
RADAR_MAX_HTTP_REQUESTS=60
RADAR_MAX_PUBLISHING_TOPICS=2
RADAR_PUBLISHING_TOPIC_MIN_SCORE=35
RADAR_MAX_TOTAL_CONTENT_PACKS=5
RADAR_MAX_QUEUE_ITEMS=100
RADAR_MAX_TELEGRAM_UPDATES=20
